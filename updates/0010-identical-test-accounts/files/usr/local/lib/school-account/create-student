#!/usr/bin/env python3
# Create a laptop account for a TDSB ID (student or staff) whose TDSB-WIFI login
# has ALREADY been verified by student-account-service.py.
#
# Usage: create-student TDSB_ID     (password on stdin)
# Account name: "tdsb-" + ID in lowercase. Full name (shown on the login screen
# and used as the TDSB-WIFI identity): the ID exactly as typed.

import os
import re
import subprocess
import sys

LOGIN_ID_PATTERN = re.compile(r"^[A-Za-z0-9]{3,27}$")


def fail(message):
    print(f"ERROR: {message}", file=sys.stderr)
    sys.exit(1)


def remove_account(username):
    subprocess.run(
        ["/usr/sbin/userdel", "--remove", username],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


if len(sys.argv) != 2:
    fail("Usage: create-student TDSB_ID")

student_id = sys.argv[1]

if not LOGIN_ID_PATTERN.fullmatch(student_id):
    fail("Your ID is 3 to 27 letters or numbers.")

username = "tdsb-" + student_id.lower()

if subprocess.run(
    ["/usr/bin/id", "-u", username],
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
).returncode == 0:
    fail("An account for this ID already exists on this laptop.")

password = sys.stdin.readline().rstrip("\n")

if not password or "\r" in password:
    fail("Invalid password.")

result = subprocess.run(
    [
        "/usr/sbin/adduser",
        "--quiet",
        "--disabled-password",
        "--comment",
        student_id,
        username,
    ],
)

if result.returncode != 0:
    fail("Account creation failed.")

result = subprocess.run(
    ["/usr/sbin/chpasswd"],
    input=f"{username}:{password}\n",
    text=True,
)

if result.returncode != 0:
    remove_account(username)
    fail("Password setup failed. The account was removed.")

try:
    # Delete My Account requires the "users" group; "dialout" lets the Arduino
    # IDE upload over USB.
    subprocess.run(["/usr/sbin/usermod", "-aG", "users,dialout", username], check=True)

    cs_dir = os.path.join("/home", username, "CS")

    for folder in ("Python", "Java", "C++", "JavaFX"):
        os.makedirs(os.path.join(cs_dir, folder), exist_ok=True)

    subprocess.run(
        ["/usr/bin/chown", "-R", f"{username}:{username}", cs_dir],
        check=True,
    )

except Exception:
    remove_account(username)
    fail("Account setup failed. The account was removed.")

print(f"Account created for {student_id}.")
