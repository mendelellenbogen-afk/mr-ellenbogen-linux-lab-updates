#!/usr/bin/env python3
# Create a student account for a 9-digit student ID whose TDSB-WIFI login has
# ALREADY been verified by student-account-service.py.
#
# Usage: create-student STUDENT_ID     (password on stdin)
# Account name: "s" + ID. Full name (shown on the login screen): the plain ID.

import os
import re
import subprocess
import sys

STUDENT_ID_PATTERN = re.compile(r"^[0-9]{9}$")


def fail(message):
    print(f"ERROR: {message}", file=sys.stderr)
    sys.exit(1)


def remove_account(username):
    subprocess.run(
        ["/usr/sbin/userdel", "--remove", username],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


if len(sys.argv) != 2:
    fail("Usage: create-student STUDENT_ID")

student_id = sys.argv[1]

if not STUDENT_ID_PATTERN.fullmatch(student_id):
    fail("A student ID is 9 digits.")

username = "s" + student_id

if subprocess.run(
    ["/usr/bin/id", "-u", username],
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
).returncode == 0:
    fail("An account for this student ID already exists on this laptop.")

password = sys.stdin.readline().rstrip("\n")

if not password or "\r" in password:
    fail("Invalid password.")

result = subprocess.run(
    [
        "/usr/sbin/adduser",
        "--quiet",
        "--disabled-password",
        "--comment",
        student_id,
        username,
    ],
)

if result.returncode != 0:
    fail("Account creation failed.")

result = subprocess.run(
    ["/usr/sbin/chpasswd"],
    input=f"{username}:{password}\n",
    text=True,
)

if result.returncode != 0:
    remove_account(username)
    fail("Password setup failed. The account was removed.")

try:
    # Delete My Account requires the "users" group.
    subprocess.run(["/usr/sbin/usermod", "-aG", "users", username], check=True)

    cs_dir = os.path.join("/home", username, "CS")

    for folder in ("Python", "Java", "C++", "JavaFX"):
        os.makedirs(os.path.join(cs_dir, folder), exist_ok=True)

    subprocess.run(
        ["/usr/bin/chown", "-R", f"{username}:{username}", cs_dir],
        check=True,
    )

except Exception:
    remove_account(username)
    fail("Account setup failed. The account was removed.")

print(f"Account created for {student_id}.")
