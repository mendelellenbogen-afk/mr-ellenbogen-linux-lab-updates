[Unit]
Description=Lab live messages: show signed pop-ups from the teacher
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /usr/local/lib/lab-messages/lab-messages-listener.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
