+// "+" button: close this window and start a new capture. The command can be overridden with
+// SWAPPY_NEW_COMMAND. It runs detached after a short delay so the new capture does not see this window.
+void new_clicked_handler(GtkWidget *widget, struct swappy_state *state) {
+  const char *cmd = g_getenv("SWAPPY_NEW_COMMAND");
+  if (cmd == NULL || cmd[0] == '\0') {
+    cmd = "/usr/local/bin/lab-snip";  // lab: start the lab snipping tool
+  }
+  gchar *line = g_strdup_printf("sh -c 'sleep 0.5; %s'", cmd);
+  GError *error = NULL;
+  if (!g_spawn_command_line_async(line, &error)) {
+    g_warning("unable to start a new capture: %s", error->message);
+    g_error_free(error);
+  }
+  g_free(line);
+  gtk_main_quit();
+}
