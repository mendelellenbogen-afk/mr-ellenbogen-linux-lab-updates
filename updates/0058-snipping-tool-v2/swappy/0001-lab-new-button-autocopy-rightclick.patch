+// Put the untouched captured image on the clipboard (used right after the window opens).
+bool clipboard_copy_original_image(struct swappy_state *state) {
+  if (!state->original_image) {
+    return false;
+  }
+  // Lab: fall back to GTK's clipboard (kept while the editor is open) if wl-copy fails.
+  if (!send_pixbuf_to_wl_copy(state->original_image)) {
+    send_pixbuf_to_gdk_clipboard(state->original_image);
+  }
+  return true;
+}
