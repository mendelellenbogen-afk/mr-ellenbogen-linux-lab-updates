#!/bin/bash
# lab-present (lab update 0021). Runs inside one user's desktop session,
# started by the live-messages listener for a signed teacher message:
#   lab-present [--volume 0-100] [--close] [URL]
#   --volume  unmute the speakers and set the volume (percent)
#   --close   close the full-screen window opened by an earlier message
#   URL       open it full screen (Firefox kiosk mode) in a separate profile
#             that may autoplay with sound; the student's own Firefox and its
#             settings are not touched. Alt+F4 closes it. On YouTube a style
#             rule stretches the video over the whole screen and hides the
#             rest of the page (YouTube's own full-screen button needs a click,
#             and its embed player refuses direct links with Error 153).
set -u
PROFILE="$HOME/snap/firefox/common/lab-fullscreen-profile"
volume="" close=0 url=""
while [ $# -gt 0 ]; do
    case "$1" in
        --volume) volume="${2:-}"; shift 2 ;;
        --close)  close=1; shift ;;
        *)        url="$1"; shift ;;
    esac
done

if [[ "$volume" =~ ^[0-9]{1,3}$ ]] && [ "$volume" -le 100 ]; then
    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
    wpctl set-volume @DEFAULT_AUDIO_SINK@ "$volume%"
fi

kiosk_pids() {     # this user's Firefox processes started with our profile
    local pid
    for pid in $(pgrep -u "$(id -u)" -x firefox); do
        tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q -- "--profile $PROFILE " && echo "$pid"
    done
}

if [ "$close" = 1 ] || [ -n "$url" ]; then
    # Only one full-screen window at a time: close the previous one.
    pids="$(kiosk_pids)"
    if [ -n "$pids" ]; then
        kill $pids 2>/dev/null
        for _ in $(seq 20); do
            [ -n "$(kiosk_pids)" ] || break
            sleep 0.25
        done
        pids="$(kiosk_pids)"
        [ -z "$pids" ] || kill -KILL $pids 2>/dev/null
    fi
fi

[ -n "$url" ] || exit 0
case "$url" in http://*|https://*) ;; *) echo "not a web link: $url" >&2; exit 1 ;; esac

mkdir -p "$PROFILE/chrome"
cat > "$PROFILE/user.js" <<'PREFS'
// Written by lab-present (lab update 0021). Only this full-screen profile.
user_pref("media.autoplay.default", 0);
user_pref("media.autoplay.blocking_policy", 0);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
PREFS
cat > "$PROFILE/chrome/userContent.css" <<'STYLE'
/* Written by lab-present (lab update 0021): YouTube's player fills the screen. */
@-moz-document domain("youtube.com") {
  html, body { overflow: hidden !important; background: #000 !important; }
  #masthead-container, ytd-masthead, #secondary, #below, #related, #comments,
  tp-yt-app-drawer, #guide, ytd-mini-guide-renderer, [id$="skeleton"] { display: none !important; }
  ytd-app, #content, #page-manager, ytd-watch-flexy, #columns, #primary, #primary-inner,
  #player, #player-container, #player-container-outer, #player-container-inner,
  #full-bleed-container, #player-full-bleed-container, #ytd-player, #container.ytd-player {
    transform: none !important; contain: none !important; filter: none !important; }
  #movie_player { position: fixed !important; inset: 0 !important; width: 100vw !important;
    height: 100vh !important; z-index: 2147483647 !important; background: #000 !important; }
  #movie_player video { position: absolute !important; inset: 0 !important; width: 100vw !important;
    height: 100vh !important; object-fit: contain !important; }
}
STYLE

firefox="${LAB_PRESENT_FIREFOX:-/snap/bin/firefox}"   # override only for testing
[ -x "$firefox" ] || firefox="$(command -v firefox)" || exit 1
exec "$firefox" --kiosk --no-remote --profile "$PROFILE" "$url"
