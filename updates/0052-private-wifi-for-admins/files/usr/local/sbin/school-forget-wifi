#!/bin/bash
# Forget Wi-Fi, except networks remembered for the teacher/test accounts and
# for other admin accounts.
#
#   school-forget-wifi              claim (see below), then forget
#   school-forget-wifi --no-claim   forget only (used at logout)
#   school-forget-wifi --claim-only claim only (the watcher, every 2 s)
#   school-forget-wifi --all        forget EVERY Wi-Fi network (imaging)
#
# Shared accounts: /etc/school-account/wifi-keep-accounts (update 0015).
# Private accounts (update 0052): every other member of the sudo group
# (uid >= 1000, not tdsb-*). Each keeps its own Wi-Fi, for itself only.
# "Claim": while ONLY shared accounts are logged in, any Wi-Fi network that
# isn't restricted to someone yet is restricted to all of them; while ONLY one
# private account is logged in, to that account alone (connection.permissions),
# so it is kept and only connects for them.
# "Forget": delete every Wi-Fi connection (saved or in-memory) except those
# restricted to shared accounts only, or to one private account alone.
# Ethernet is untouched.
#
# If /run/school-forget-wifi.skip exists, do nothing once (used by lab updates
# that restart the watcher without kicking the current person off Wi-Fi).

NMCLI="${SCHOOL_NMCLI:-/usr/bin/nmcli}"
LOGINCTL="${SCHOOL_LOGINCTL:-/usr/bin/loginctl}"
GETENT="${SCHOOL_GETENT:-/usr/bin/getent}"
KEEP_FILE="${SCHOOL_WIFI_KEEP_FILE:-/etc/school-account/wifi-keep-accounts}"
SKIP_FILE="${SCHOOL_FORGET_SKIP:-/run/school-forget-wifi.skip}"

mode="${1:-}"

if { [ -z "$mode" ] || [ "$mode" = "--no-claim" ]; } && [ -e "$SKIP_FILE" ]; then
    rm -f "$SKIP_FILE"
    exit 0
fi

keepers=()
if [ "$mode" != "--all" ] && [ -r "$KEEP_FILE" ]; then
    while read -r name _; do
        case "$name" in ''|'#'*) continue ;; esac
        keepers+=("$name")
    done < "$KEEP_FILE"
fi

is_keeper() {
    local name
    for name in "${keepers[@]}"; do [ "$name" = "$1" ] && return 0; done
    return 1
}

# Sudo-group accounts that aren't shared keepers (or students).
private_users=()
if [ "$mode" != "--all" ]; then
    members="$("$GETENT" group sudo 2>/dev/null | cut -d: -f4 | tr ',' ' ')"
    for name in $members; do
        case "$name" in tdsb-*) continue ;; esac
        is_keeper "$name" && continue
        uid="$("$GETENT" passwd "$name" 2>/dev/null | cut -d: -f3)"
        [ -n "$uid" ] && [ "$uid" -ge 1000 ] 2>/dev/null || continue
        private_users+=("$name")
    done
fi

is_private() {
    local name
    for name in "${private_users[@]}"; do [ "$name" = "$1" ] && return 0; done
    return 1
}

wifi_uuids() {
    "$NMCLI" -t -f UUID,TYPE connection show 2>/dev/null |
        awk -F: '$2 == "802-11-wireless" { print $1 }'
}

# Users in the connection's permissions ("" = everyone).
permission_users() {
    "$NMCLI" -e no -g connection.permissions connection show uuid "$1" 2>/dev/null |
        tr ',' '\n' | sed -e 's/^[[:space:]]*//' -e 's/^user://' -e 's/:.*$//' | grep -v '^$'
}

logged_in_users() {
    "$LOGINCTL" list-sessions --no-legend 2>/dev/null | awk '$6 == "user" { print $3 }' | sort -u
}

# Who the free networks go to right now: the shared list, one private
# account, or nobody (empty).
claim_list() {
    local users user list
    users="$(logged_in_users)"
    [ -n "$users" ] || return 0
    if [ "${#keepers[@]}" -gt 0 ]; then
        list=1
        for user in $users; do is_keeper "$user" || list=0; done
        if [ "$list" = 1 ]; then
            list="$(printf 'user:%s,' "${keepers[@]}")"
            echo "${list%,}"
            return 0
        fi
    fi
    if [ "$(echo "$users" | wc -l)" -eq 1 ] && is_private "$users"; then
        echo "user:$users"
    fi
}

claim() {
    local uuid list
    list="$(claim_list)"
    [ -n "$list" ] || return 0
    for uuid in $(wifi_uuids); do
        if [ -z "$(permission_users "$uuid")" ]; then
            "$NMCLI" connection modify uuid "$uuid" connection.permissions "$list" >/dev/null 2>&1
        fi
    done
}

forget() {
    local uuid users user keep
    for uuid in $(wifi_uuids); do
        keep=0
        users="$(permission_users "$uuid")"
        if [ "$mode" != "--all" ] && [ -n "$users" ]; then
            keep=1
            for user in $users; do is_keeper "$user" || keep=0; done
            if [ "$keep" = 0 ] && [ "$(echo "$users" | wc -l)" -eq 1 ] && is_private "$users"; then
                keep=1
            fi
        fi
        [ "$keep" = 1 ] || "$NMCLI" connection delete uuid "$uuid" >/dev/null 2>&1
    done
}

case "$mode" in
    --claim-only) claim ;;
    --no-claim|--all) forget ;;
    *) claim; forget ;;
esac
exit 0
